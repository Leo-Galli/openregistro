{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm --filter @openregistro/website build",
  "outputDirectory": "out",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/cp", "destination": "https://demo.openregistro.another-horizon.eu/cp" },
    {
      "source": "/cp/:path*",
      "destination": "https://demo.openregistro.another-horizon.eu/cp/:path*"
    },
    {
      "source": "/cp-assets/:path*",
      "destination": "https://demo.openregistro.another-horizon.eu/cp-assets/:path*"
    }
  ]
}
