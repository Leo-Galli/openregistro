# Storage driver: "json" (no database, data/ directory) or "postgres".
STORAGE_DRIVER=json

# Only used when STORAGE_DRIVER=json. Defaults to ./data if unset.
DATA_DIR=./data

# Only used when STORAGE_DRIVER=postgres. Run `pnpm --filter @openregistro/db db:migrate`
# (with this value set) before starting the app.
DATABASE_URL=postgres://openregistro:openregistro@localhost:5432/openregistro

# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this deployment. Required behind some reverse proxies;
# Auth.js can usually infer it from request headers otherwise.
AUTH_URL=http://localhost:3000

NODE_ENV=development

# Optional: SMTP for outgoing email (announcements, meeting confirmations,
# password resets). Leave unset to disable email sending; the app still works
# without it, the wizard's SMTP step can be skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OpenRegistro <no-reply@example.com>

# Optional, operator-only: credentials for the hidden /cp control panel (free
# hosting requests, deployment status). Leave both unset to disable /cp
# entirely - every self-hosted install should leave these unset.
# Generate CP_ADMIN_PASSWORD_HASH with:
#   pnpm --filter @openregistro/web hash-cp-password '<your password>'
CP_ADMIN_USERNAME=admin
CP_ADMIN_PASSWORD_HASH=

# Optional, operator-only: a Vercel Deploy Hook URL for the managed demo
# project (Project Settings -> Git -> Deploy Hooks). When set, the /cp
# control panel's "Redeploy latest" button becomes a real one-click
# redeploy; otherwise it just shows manual update instructions. Unset on
# every self-hosted install.
CP_DEMO_DEPLOY_HOOK_URL=
