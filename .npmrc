# Vercel's own CLI package (used by apps/web/lib/provisioning to shell out for
# automated school provisioning) depends on dozens of @vercel/* packages
# (@vercel/cli-auth, per-framework builders, a platform-specific native
# binary) AND several plain packages (chokidar, esbuild, jose, jsonc-parser,
# luxon, sandbox, smol-toml, undici, uuid, zod) that pnpm's strict isolation
# keeps private inside vercel's own .pnpm store entry rather than hoisting.
# Next.js's outputFileTracingIncludes glob matching skips dot-prefixed path
# segments (like .pnpm), so none of those can ever be force-included from
# inside .pnpm/vercel@.../node_modules/ no matter how the glob is written -
# confirmed by inspecting the actual .next/server/app/cp/page.js.nft.json
# manifest, not guessed. Hoisting these to the workspace root node_modules/
# puts them at an ordinary, glob-reachable path instead - see
# apps/web/next.config.ts's outputFileTracingIncludes comment.
public-hoist-pattern[]=@vercel/*
public-hoist-pattern[]=chokidar
public-hoist-pattern[]=esbuild
public-hoist-pattern[]=jose
public-hoist-pattern[]=jsonc-parser
public-hoist-pattern[]=luxon
public-hoist-pattern[]=sandbox
public-hoist-pattern[]=smol-toml
public-hoist-pattern[]=undici
public-hoist-pattern[]=uuid
# zod is also a direct dependency of this monorepo's own packages at a
# different pinned version - hoisting is still safe because pnpm's "nearest
# wins" resolution means every existing explicit `import 'zod'` in this repo
# keeps resolving to its own already-symlinked version regardless of what
# else also gets hoisted to the workspace root; this only adds vercel's own
# copy at a glob-reachable path for its own internal use.
public-hoist-pattern[]=zod
